{
  "manifest_version": 3,
  "name": "SentinelAI Phishing Core",
  "version": "1.0.0",
  "description": "Real-Time AI-Powered Phishing Defense and Behavioral Heuristic DOM Inspector.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentinelAI Threat Console"
  }
}
